{
  "name": "pluto-message-ingestion",
  "version": "0.0.0",
  "type": "module",
  "repository": "git@github.com:guardian/media-atom-maker.git",
  "author": "The Guardian <digitalcms.dev@theguardian.com>",
  "description": "Ingesting messages sent from Pluto via a Kinesis stream",
  "packageName": "media-service:media-atom-maker:pluto-message-ingestion",
  "main": "index.js",
  "scripts": {
    "lint:ci": "eslint --no-error-on-unmatched-pattern -c ./eslint.config.mjs",
    "lint": "yarn lint:ci --fix",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "tscconfig": "tsc --showConfig",
    "test": "vitest",
    "test:ci": "vitest --run",
    "build": "esbuild src/index.ts --bundle --minify --outfile=target/index.js --external:@aws-sdk --platform=node"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1162.0",
    "@aws-sdk/credential-providers": "3.1162.0",
    "@guardian/libs": "26.0.0",
    "esbuild": "0.28.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@guardian/eslint-config": "12.0.0",
    "@guardian/tsconfig": "^1.0.0",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.15.35",
    "eslint": "9.37.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "prettier": "3.9.10",
    "typescript": "5.5.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
